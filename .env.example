# ─────────────────────────────────────────────────────────────────────────────
# JARVIS Autonomous AI OS — Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── NVIDIA NIM (REQUIRED — system will refuse to start without a valid key) ──
NVIDIA_NIM_API_KEY=nvapi-your-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Model Selection ──────────────────────────────────────────────────────────
MODEL_COMPLEX=meta/llama-3.1-70b-instruct
MODEL_FAST=mistralai/mistral-7b-instruct-v0.3
MODEL_BALANCED=mistralai/mixtral-8x7b-instruct-v0.1
MODEL_CODE=meta/codellama-70b-instruct
MODEL_EMBED=nvidia/nv-embedqa-e5-v5

# ── Infrastructure ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis

# ── Service Ports ────────────────────────────────────────────────────────────
AGENT_CORE_PORT=8000
BROKER_PORT=8001
LLM_ENGINE_PORT=8002
MEMORY_PORT=8003
TOOL_SYSTEM_PORT=8004
VOICE_PORT=8005

# ── Message Broker ───────────────────────────────────────────────────────────
BROKER_ADDR=0.0.0.0:8001
BROKER_WS_URL=ws://localhost:8001/ws

# ── Memory Service ───────────────────────────────────────────────────────────
MEMORY_VECTOR_DIM=1024
MEMORY_URL=http://localhost:8003

# ── LLM Engine ───────────────────────────────────────────────────────────────
LLM_ENGINE_URL=http://localhost:8002

# ── Tool System ──────────────────────────────────────────────────────────────
TOOL_SYSTEM_URL=http://localhost:8004
TOOL_AUTH_SECRET=jarvis-dev-secret-change-in-production
SANDBOX_DIR=/tmp/jarvis-sandbox
DOCKER_SANDBOX=false

# ── Voice Service ────────────────────────────────────────────────────────────
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+0%
VOICE_URL=http://localhost:8005

# ── Agent Core ───────────────────────────────────────────────────────────────
MAX_ITERATIONS=5
CRITIC_THRESHOLD=0.7

# ── Observability ────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LOG_LEVEL=INFO

# ── UI ───────────────────────────────────────────────────────────────────────
VITE_AGENT_CORE_URL=http://localhost:8000
VITE_BROKER_WS_URL=ws://localhost:8001/ws
VITE_MEMORY_URL=http://localhost:8003
VITE_VOICE_URL=http://localhost:8005
