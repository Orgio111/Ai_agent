# NVIDIA NIM API Configuration
NVIDIA_NIM_API_KEY=nvapi-your-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model Selection
MODEL_COMPLEX=meta/llama-3.1-70b-instruct
MODEL_FAST=mistralai/mistral-7b-instruct-v0.3
MODEL_BALANCED=mistralai/mixtral-8x7b-instruct-v0.1
MODEL_EMBED=nvidia/nv-embedqa-e5-v5

# AI Core (Python FastAPI)
AI_CORE_HOST=0.0.0.0
AI_CORE_PORT=8000

# API Gateway (Go)
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9000
AI_CORE_URL=http://localhost:8000

# Memory
MEMORY_DIR=./data/memory
SHORT_TERM_MAX=50
LONG_TERM_DIM=1024

# Agent Loop
MAX_ITERATIONS=5
CRITIC_THRESHOLD=0.75

# Logging
LOG_LEVEL=INFO

# Optional: Rust performance module URL (if running as service)
RUST_PERF_URL=http://localhost:7070
